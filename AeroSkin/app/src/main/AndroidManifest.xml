<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"> <!-- Notice 'package' is gone -->

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_placeholder"         
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_placeholder"   
        android:supportsRtl="true"
        android:theme="@style/Theme.AeroSkin">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".ManualBrightnessActivity" />
    </application>

    <!-- Add these permissions before the <application> tag -->
<uses-permission android:name="android.permission.CAMERA" />
<uses-permission android:name="android.permission.INTERNET" />

<!-- Declare that the app uses a camera -->
<uses-feature android:name="android.hardware.camera.any" />

</manifest>